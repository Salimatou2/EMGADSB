@{
    ViewData["Title"] = "Accès refusé";
}

<div class="container my-5 text-center">
    <div class="alert alert-danger shadow-sm p-5">
        <i class="fas fa-exclamation-circle fa-4x mb-4"></i>
        <h1 class="display-4">Accès refusé</h1>
        <p class="lead">Vous n'avez pas les autorisations nécessaires pour accéder à cette page.</p>
        <hr>
        <p>Veuillez contacter l'administrateur si vous pensez que c'est une erreur.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary mt-3">
            <i class="fas fa-home me-2"></i>Retour à l'accueil
        </a>
    </div>
</div>