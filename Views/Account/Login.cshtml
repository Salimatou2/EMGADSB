@using EMGADSB.ViewModels
@model LoginViewModel
@{
    ViewData["Title"] = "Connexion | EMG Voitures";
}

<!-- Styles personnalisés -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    .login-container {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #f8f9fa;
    }

    .login-card {
        border: none;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
        max-width: 500px;
        width: 100%;
    }

    .login-header {
        background: linear-gradient(135deg, #0062cc, #0d6efd);
        padding: 2rem;
        text-align: center;
    }

    .login-header-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
    }

    .login-header-text {
        font-size: 1.5rem;
        font-weight: 600;
    }

    .login-body {
        padding: 2.5rem;
        background-color: white;
    }

    .form-floating > .form-control {
        padding: 1rem 0.75rem;
        height: calc(3.5rem + 2px);
    }

    .form-floating > label {
        padding: 1rem 0.75rem;
    }

    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }

    .login-btn {
        padding: 0.75rem;
        font-size: 1.1rem;
        font-weight: 500;
        border-radius: 30px;
        transition: all 0.3s ease;
    }

        .login-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(13, 110, 253, 0.4);
        }

    .login-footer {
        padding: 1.5rem;
        background-color: rgba(13, 110, 253, 0.05);
        border-top: 1px solid rgba(0, 0, 0, 0.05);
    }

    .create-account-link {
        color: #0d6efd;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.3s ease;
    }

        .create-account-link:hover {
            text-decoration: underline;
        }

    .input-group-text {
        background-color: transparent;
        cursor: pointer;
    }

    .password-toggle {
        cursor: pointer;
    }
</style>

<div class="login-container animate__animated animate__fadeIn">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <!-- Fil d'Ariane -->
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Accueil</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Connexion</li>
                    </ol>
                </nav>

                <div class="login-card animate__animated animate__fadeInUp">
                    <div class="login-header text-white">
                        <div class="login-header-icon">
                            <i class="bi bi-car-front-fill"></i>
                        </div>
                        <h1 class="login-header-text">Connexion à EMG Voitures</h1>
                        <p class="mt-2 mb-0">Entrez vos identifiants pour accéder à votre compte</p>
                    </div>

                    <div class="login-body">
                        <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                            <!-- Champ caché pour ReturnUrl -->
                            <input type="hidden" asp-for="ReturnUrl" value="@ViewData["ReturnUrl"]" />

                            <div class="mb-4">
                                <div class="form-floating">
                                    <input asp-for="Email" class="form-control" type="email" autocomplete="email" placeholder="nom@exemple.com" />
                                    <label asp-for="Email"><i class="bi bi-envelope me-2"></i>Adresse email</label>
                                </div>
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="mb-4">
                                <div class="form-floating">
                                    <input asp-for="Password" class="form-control" type="password" id="password" autocomplete="current-password" placeholder="Mot de passe" />
                                    <label asp-for="Password"><i class="bi bi-lock me-2"></i>Mot de passe</label>
                                </div>
                                <span asp-validation-for="Password" class="text-danger"></span>
                                <div class="d-flex justify-content-end mt-1">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="showPassword">
                                        <label class="form-check-label small text-muted" for="showPassword">Afficher le mot de passe</label>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-4">
                                <div class="form-check">
                                    <input asp-for="RememberMe" class="form-check-input" />
                                    <label asp-for="RememberMe" class="form-check-label">Se souvenir de moi</label>
                                </div>
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary login-btn">
                                    <i class="bi bi-box-arrow-in-right me-2"></i>Connexion
                                </button>
                            </div>
                        </form>
                    </div>

                    <div class="login-footer text-center">
                        <p class="mb-0">Vous n'avez pas de compte ? <a asp-action="Register" class="create-account-link">Créer un compte</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            // Fonctionnalité pour afficher/masquer le mot de passe
            $('#showPassword').change(function() {
                var passwordInput = $('#password');
                if ($(this).is(':checked')) {
                    passwordInput.attr('type', 'text');
                } else {
                    passwordInput.attr('type', 'password');
                }
            });

            // Animation pour les messages d'erreur
            if ($('.validation-summary-errors').length > 0) {
                $('.validation-summary-errors').addClass('animate__animated animate__headShake');
            }
        });
    </script>
}