@{
    ViewData["Title"] = "Tableau de bord - Administration";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<h1 class="mb-4"><i class="bi bi-speedometer2"></i> Tableau de bord</h1>

<div class="row g-4">

    <!-- Gestion des voitures -->
    <div class="col-md-4">
        <div class="card shadow-sm border-start border-primary border-4 h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-car-front-fill fs-2 text-primary me-3"></i>
                    <h5 class="card-title mb-0">Voitures</h5>
                </div>
                <p class="card-text text-muted">Gérez l'inventaire des voitures, ajoutez, modifiez ou marquez les voitures comme vendues.</p>
                <a asp-controller="Cars" asp-action="Index" class="btn btn-outline-primary btn-sm">Voir l'inventaire</a>
            </div>
        </div>
    </div>

    <!-- Statistiques -->
    <div class="col-md-4">
        <div class="card shadow-sm border-start border-success border-4 h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-bar-chart-line-fill fs-2 text-success me-3"></i>
                    <h5 class="card-title mb-0">Statistiques</h5>
                </div>
                <p class="card-text text-muted">Consultez les données de ventes et de performance des voitures disponibles.</p>
                <a asp-controller="Admin" asp-action="Statistics" class="btn btn-outline-success btn-sm">Voir les statistiques</a>
            </div>
        </div>
    </div>

    <!-- Marques & modèles -->
    <div class="col-md-4">
        <div class="card shadow-sm border-start border-warning border-4 h-100">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-tags-fill fs-2 text-warning me-3"></i>
                    <h5 class="card-title mb-0">Marques & Modèles</h5>
                </div>
                <p class="card-text text-muted">Ajoutez ou modifiez les marques et modèles disponibles dans votre base de données.</p>
                <a asp-controller="Admin" asp-action="ManageMakesModels" class="btn btn-outline-warning btn-sm">Gérer</a>
            </div>
        </div>
    </div>

</div>

<style>
    h1 {
        font-weight: 600;
        color: #333;
    }

    .card {
        transition: all 0.3s ease-in-out;
    }

    .card:hover {
        transform: scale(1.02);
    }
</style>
