@model EMGADSB.ViewModels.CreateCarViewModel

@{
    ViewData["Title"] = "Ajouter une voiture";
}

<div class="container my-5">
    <h1 class="mb-4">Ajouter une nouvelle voiture</h1>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Nom</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Year" class="form-label">Année</label>
                            <input asp-for="Year" class="form-control" type="number" min="2018" max="2100" />
                            <span asp-validation-for="Year" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Price" class="form-label">Prix</label>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="CarMakeId" class="form-label">Marque</label>
                            <select asp-for="CarMakeId" class="form-select"
                                    asp-items="@(new SelectList(Model.AvailableMakes, "Id", "Name"))"
                                    id="makeSelect">
                                <option value="">-- Sélectionnez une marque --</option>
                            </select>
                            <span asp-validation-for="CarMakeId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CarModelId" class="form-label">Modèle</label>
                            <select asp-for="CarModelId" class="form-select" id="modelSelect" disabled>
                                <option value="">-- Sélectionnez d'abord une marque --</option>
                            </select>
                            <span asp-validation-for="CarModelId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Image" class="form-label">Image</label>
                            <input asp-for="Image" class="form-control" type="file" accept="image/*" />
                            <span asp-validation-for="Image" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="text-end">
                    <a asp-action="Index" class="btn btn-secondary">Annuler</a>
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        $(document).ready(function() {
            // Gestion dynamique des modèles en fonction de la marque
            $('#makeSelect').change(function() {
                var makeId = $(this).val();
                if (makeId === '') {
                    $('#modelSelect').prop('disabled', true);
                    $('#modelSelect').html('<option value="">-- Sélectionnez d\'abord une marque --</option>');
                    return;
                }

                $.ajax({
                    url: '/api/get-models-by-make',
                    type: 'GET',
                    data: { makeId: makeId },
                    success: function(models) {
                        var options = '<option value="">-- Sélectionnez un modèle --</option>';
                        $.each(models, function(i, model) {
                            options += '<option value="' + model.id + '">' + model.name + '</option>';
                        });
                        $('#modelSelect').html(options);
                        $('#modelSelect').prop('disabled', false);
                    },
                    error: function(xhr, status, error) {
                        console.error("Erreur lors du chargement des modèles:", error);
                        $('#modelSelect').prop('disabled', true);
                        $('#modelSelect').html('<option value="">-- Erreur de chargement --</option>');
                    }
                });
            });
        });
    </script>
}