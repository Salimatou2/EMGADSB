@model EMGADSB.Models.Car

@{
    ViewData["Title"] = "Détails de la voiture";
}

<div class="container my-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Accueil</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Inventaire</a></li>
            <li class="breadcrumb-item active" aria-current="page">Détails</li>
        </ol>
    </nav>

    <div class="card shadow-sm">
        <div class="row g-0">
            <div class="col-md-5">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="img-fluid rounded-start h-100" style="object-fit: cover;" alt="@Model.Name">
                }
                else
                {
                    <img src="/images/cars/default.jpg" class="img-fluid rounded-start h-100" style="object-fit: cover;" alt="@Model.Name">
                }
            </div>
            <div class="col-md-7">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <h1 class="card-title">@Model.Name</h1>
                        <h3 class="text-primary">@Model.Price.ToString("C")</h3>
                    </div>
                    <h4 class="card-subtitle mb-3 text-muted">@Model.CarMake.Name @Model.CarModel.Name (@Model.Year)</h4>

                    @if (!Model.IsAvailable)
                    {
                        <div class="badge bg-danger mb-3 fs-6">Non disponible</div>
                    }
                    else if (Model.IsSold)
                    {
                        <div class="badge bg-warning mb-3 fs-6">Vendu</div>
                    }
                    else
                    {
                        <div class="badge bg-success mb-3 fs-6">Disponible</div>
                    }

                    <hr>
                    <h5>Description</h5>
                    <p class="card-text">@Model.Description</p>

                    <hr>
                    <h5>Caractéristiques</h5>
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Marque:</strong> @Model.CarMake.Name</p>
                            <p><strong>Modèle:</strong> @Model.CarModel.Name</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Année:</strong> @Model.Year</p>
                            <p><strong>Prix:</strong> @Model.Price.ToString("C")</p>
                        </div>
                    </div>

                    <div class="mt-4">
                        <a asp-action="Index" class="btn btn-secondary">Retour à la liste</a>

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Modifier</a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Supprimer</a>

                            @if (!Model.IsSold && Model.IsAvailable)
                            {
                                <form asp-action="MarkAsSold" asp-route-id="@Model.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-warning">Marquer comme vendu</button>
                                </form>
                            }

                            @if (Model.IsAvailable)
                            {
                                <form asp-action="MarkAsUnavailable" asp-route-id="@Model.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger">Marquer comme indisponible</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="MarkAsAvailable" asp-route-id="@Model.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-success">Marquer comme disponible</button>
                                </form>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
