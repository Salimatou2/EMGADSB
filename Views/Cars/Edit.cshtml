@* Cars/Edit.cshtml *@
@model EMGADSB.Models.Car

@{
    ViewData["Title"] = "Modifier la voiture";
}

<h1>Modifier la voiture</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="CarMakeId" class="control-label">Marque</label>
                <select asp-for="CarMakeId" class="form-control" asp-items="ViewBag.CarMakes" id="makeSelect">
                </select>
                <span asp-validation-for="CarMakeId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Model" class="control-label">Modèle</label>
                <select asp-for="Model" class="form-control" id="modelSelect">
                </select>
                <span asp-validation-for="Model" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Year" class="control-label">Année</label>
                <input asp-for="Year" class="form-control" type="number" min="2018" max="2025" />
                <span asp-validation-for="Year" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PurchasePrice" class="control-label">Prix d'achat</label>
                <input asp-for="PurchasePrice" class="form-control" />
                <span asp-validation-for="PurchasePrice" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SellingPrice" class="control-label">Prix de vente</label>
                <input asp-for="SellingPrice" class="form-control" />
                <span asp-validation-for="SellingPrice" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="control-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="mb-2">
                        <img src="@Model.ImageUrl" style="max-width:300px" />
                    </div>
                }

                <label class="control-label">Nouvelle image (optionnel)</label>
                <input type="file" name="ImageFile" class="form-control-file" />
            </div>

            <div class="form-group">
                <div class="form-check">
                    <input asp-for="IsAvailable" class="form-check-input" />
                    <label asp-for="IsAvailable" class="form-check-label">Disponible</label>
                </div>
            </div>

            <div class="form-group">
                <input type="submit" value="Enregistrer" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Annuler</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Charger les modèles pour la marque sélectionnée au chargement de la page
            loadModels();

            // Recharger les modèles quand la marque change
            $('#makeSelect').change(function () {
                loadModels();
            });

            function loadModels() {
                var makeId = $('#makeSelect').val();
                if (makeId) {
                    var selectedModel = '@Model.Model';
                    $.getJSON('/api/CarMakes/' + makeId + '/models', function (data) {
                        $('#modelSelect').empty();
                        $.each(data, function (i, item) {
                            var selected = (item.name === selectedModel) ? 'selected' : '';
                            $('#modelSelect').append('<option value="' + item.name + '" ' + selected + '>' + item.name + '</option>');
                        });
                    });
                }
            }
        });
    </script>
}
